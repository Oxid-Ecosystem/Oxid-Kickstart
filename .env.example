# OxidDB starter kit configuration
#
# Copy this file to .env and fill in your instance details:
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# Base URL of your provisioned OxidDB instance, without a trailing slash.
# Used by `make test`.
OXID_URL=https://your-instance-id.oxid-db.com

# API key for the instance, sent as a bearer token.
# Mint one with POST /auth/api-keys (see docs/<version>/authentication.html).
# API keys are prefixed oxk_. Leave empty if authentication is disabled on
# your instance (the default on a fresh install).
OXID_API_KEY=oxk_your_api_key_here
